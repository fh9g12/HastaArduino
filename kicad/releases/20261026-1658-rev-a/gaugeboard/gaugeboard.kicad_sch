)) (instances (project "gaugeboard" (path "/78668b79-11e9-49f7-aeed-21b3db3ec39d" (reference "R6") (unit 1))))) (wire (pts (xy 370.84 194.31) (xy 370.84 198.12)) (stroke (width 0) (type default)) (uuid "e9f557bd-67a1-47c9-8d3d-5278eac58125")) (wire (pts (xy 370.84 198.12) (xy 370.84 201.93)) (stroke (width 0) (type default)) (uuid "a9ae8a31-c39c-4674-8280-2a7c7858c46b")) (junction (at 370.84 198.12) (diameter 0) (color 0 0 0 0) (uuid "4412b048-df40-4b58-bbd0-6216fa57bc97")) (wire (pts (xy 370.84 198.12) (xy 383.54 198.12)) (stroke (width 0) (type default)) (uuid "59cb384a-4e8f-4366-8d01-cfd213dcfd42")) (label "ADS_REF" (at 383.54 198.12 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "3c214f7c-aa63-4851-8fa1-2ed3aea8fdec")) (wire (pts (xy 370.84 186.69) (xy 370.84 181.61)) (stroke (width 0) (type default)) (uuid "ec0adbd0-3cbd-49d2-8426-9a9144662041")) (label "+3V3" (at 370.84 181.61 90) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a8a5adae-e0f4-454c-94e7-dbc848c3f02b")) (wire (pts (xy 370.84 209.55) (xy 370.84 214.63)) (stroke (width 0) (type default)) (uuid "b367bad6-1d32-4bef-ac84-be17785dca67")) (label "GND" (at 370.84 214.63 270) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "8194ae4a-5753-4858-bc7d-f853111fe5d3")) (rectangle (start 360.68 180.34) (end 381 215.9) (stroke (width 0) (type dash)) (fill (type none)) (uuid "958ae578-c93b-45f5-8164-f6adc59d7d6f")) (text "Shared completion\nresistors (fixed)\n-> A1 of BOTH ADCs" (exclude_from_sim no) (at 360.68 173.99 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a7c2cc46-f741-4795-8265-32e7ef3a40e0")) (text "NOTES\n1. Each half-bridge head (2 gauges) plugs into a 3-pin header: V (+3V3), SIG (mid-point), GND. The two fixed 350R\n   completion resistors are shared; their mid-point (ADS_REF) goes to A1 of both ADCs. Excitation is the ADC's own VIN, so\n   VREF_SUPPLY is ratiometric: no Ref+/Ref- wiring.\n2. 3V3 comes ONLY from the on-board LDO (from the loom's 5 V): cable voltage drop and the main board's switching noise do\n   not reach the bridges or the ADC reference. The ADC logic lines (SDA/SCL) are pulled up by the ADS122C04 breakouts to\n   this 3V3 and are 3.3 V logic: the master must not drive them above 3.6 V. Each breakout also has its own 10uF + 100nF on\n   VIN, so no extra ADC decoupling is fitted here.\n3. Input filters are optional: with the 0R links and no capacitor fitted there is none (original behaviour). Fit 1k in each\n   link and 100nF across A0-A1 for about an 800 Hz low-pass (the 100nF positions are marked DNP).\n4. ADS #2: bridge its ADDR0 solder jumper (ADDR0 is pulled to GND by 10k, so the jumper ties it to VCC: expected address 0x41;\n   the main board's firmware scans at boot). The Adafruit breakouts carry 10k pull-ups on SDA/SCL to their VIN.\n5. Use shielded twisted cable for the gauge wires, shield to GND at this board only." (exclude_from_sim no) (at 20 277 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b894d82e-17a9-45e1-b412-735c09f74059")) (sheet_instances (path "/" (page "1"))) (embedded_fonts no))