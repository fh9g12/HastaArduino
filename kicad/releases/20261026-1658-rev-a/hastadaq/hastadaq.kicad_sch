 330.2 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "f2a030d8-39d8-4d8e-95b1-91b0b209cd38")) (wire (pts (xy 561.34 332.74) (xy 556.26 332.74)) (stroke (width 0) (type default)) (uuid "73b42e47-4fb8-46cc-b5a1-db193a4824d5")) (label "TRIG_PU" (at 556.26 332.74 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "4ef774aa-0d0a-4603-ab1a-af98ddbd56bc")) (wire (pts (xy 561.34 335.28) (xy 556.26 335.28)) (stroke (width 0) (type default)) (uuid "2eefa938-86e3-4ab3-8d44-62f4392f0653")) (label "+12V" (at 556.26 335.28 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "f4390e6a-bcca-4c1a-a864-beccaf09836b")) (text "Shunt pins 1-2 (3V3), 2-3 (5V) or 4-5 (12V) to pull TRIG_OUT up to that rail; fit none if the receiver has its own pull-up.\nPins 2 and 4 are both TRIG_PU. Fit ONE shunt only (two shunts could join rails).\nPull-up current: 3.3 V ~2 mA, 5 V ~3 mA, 12 V ~7 mA (enough for a 6.5 mA opto input such as MPS4200).\n24 V receivers: no jumper, add an external 24 V pull-up in the harness. 3V3 for eSync 2 high-Z ports (3.3 V max)." (exclude_from_sim no) (at 430 345 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5b2cf672-8a13-4fb1-815e-d28ddc24cbf5")) (symbol (lib_id "HastaDAQ:Header1x03_GNDpVpSIG") (at 396.24 149.86 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "aa56c9b1-f312-4c87-bec1-d8f8eabd8821") (property "Reference" "J10" (at 388.62 140.97 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Value" "SBUS IN (RC receiver): GND, V, SIG" (at 388.62 143.51 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (at 396.24 149.86 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Datasheet" "" (at 396.24 149.86 0) (effects (font (size 1.27 1.27)) (hide yes))) (pin "1" (uuid "c1c75d67-2086-47fd-a597-fb4ca467a217")) (pin "2" (uuid "f6eefe4f-c06c-4fef-be92-8e50