n "2" (uuid "cad7eea4-7531-448f-935d-88b23a3b9044")) (instances (project "hastadaq" (path "/fc19b14d-ae34-4a4a-bb68-4981456816d0" (reference "R14") (unit 1))))) (wire (pts (xy 535.94 311.15) (xy 535.94 306.07)) (stroke (width 0) (type default)) (uuid "d2056d8b-8c5b-4464-a254-0ec31d5b6dd0")) (label "TRIG_PU" (at 535.94 306.07 90) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8346b7cd-bb08-4cdc-acd4-fbf9da0e71a2")) (wire (pts (xy 535.94 318.77) (xy 535.94 323.85)) (stroke (width 0) (type default)) (uuid "b1d3aa11-8704-4b21-86b5-ca87ee621216")) (label "TRIG_OUT" (at 535.94 323.85 270) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "f313ae00-11dc-4502-8ee8-b22cc3b28a7b")) (symbol (lib_id "HastaDAQ:Header2x03_PU_SEL") (at 568.96 316.23 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "3d4ea08e-d3a8-4a2a-948c-f77c1911c9aa") (property "Reference" "J10" (at 561.34 303.53 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Value" "TRIG_OUT pull-up sel." (at 561.34 306.07 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_2x03_P2.54mm_Vertical" (at 568.96 316.23 0) (effects (font (size 1.27 1.27)) (hide yes))) (property "Datasheet" "" (at 568.96 316.23 0) (effects (font (size 1.27 1.27)) (hide yes))) (pin "1" (uuid "2deb6a50-f333-4caa-99b7-c5da3f9681dd")) (pin "2" (uuid "3ca943f4-35c9-4ba2-aac3-668ec07b4a9d")) (pin "3" (uuid "b261ccd7-fc5e-438a-98c7-1d55312efc9b")) (pin "4" (uuid "11b499ba-71d9-433d-b459-18afbc7c015d")) (pin "5" (uuid "0f107422-ecd9-4e91-b096-08b6c2f705e2")) (pin "6" (uuid "be4aa768-eece-4bf3-9854-46e68d7ec77f")) (instances (project "hastadaq" (path "/fc19b14d-ae34-4a4a-bb68-4981456816d0" (reference "J10") (unit 1))))) (wire (pts (xy 556.26 309.88) (xy 551.18 309.88)) (stroke (width 0) (type default)) (uuid "818de13e-6766-462e-87a1-43334e37c514")) (label "+3V3" (at 551.18 309.88 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "a0c5ec0d-c256-42a3-ad40-2dd2fe87f490")) (wire (pts (xy 556.26 312.42) (xy 551.18 312.42)) (stroke (width 0) (type default)) (uuid "818bc0b5-46b4-427f-89de-5fb63ffee864")) (label "TRIG_PU" (at 551.18 312.42 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "178a7346-c02d-45cd-b810-9a1c1bcf5f17")) (wire (pts (xy 556.26 314.96) (xy 551.18 314.96)) (stroke (width 0) (type default)) (uuid "0602beae-9aed-4491-aeee-656d613cf3d9")) (label "+5V" (at 551.18 314.96 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "69a4fe78-f48a-4e62-a395-10e0012c6e9f")) (wire (pts (xy 556.26 317.5) (xy 551.18 317.5)) (stroke (width 0) (type default)) (uuid "3570c4da-b052-4e0a-8d05-3269799abec1")) (label "TRIG_PU" (at 551.18 317.5 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "56efb2e1-3e7a-417c-bba6-7dae9030fac0")) (wire (pts (xy 556.26 320.04) (xy 551.18 320.04)) (stroke (width 0) (type default)) (uuid "d0f87a4e-e3ce-429d-b612-6c4a86841c51")) (label "+12V" (at 551.18 320.04 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "dd556637-3c3f-4d9c-a86d-75ef72bc4a20")) (wire (pts (xy 556.26 322.58) (xy 551.18 322.58)) (stroke (width 0) (type default)) (uuid "dd51197a-5852-4c49-8893-0026ed64d8ad")) (label "TRIG_PU" (at 551.18 322.58 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "f9060d9a-7a1a-4274-ac22-f4d14651a9d2")) (text "Jumper a row (3V3 / 5V / 12V) to pull TRIG_OUT up to that rail; remove it if the receiver has its own pull-up.\nPull-up current: 3.3 V ~2 mA, 5 V ~3 mA, 12 V ~7 mA (enough for a 6.5 mA opto input such as MPS4200).\n24 V receivers: no jumper, add an external 24 V pull-up in the harness. 3V3 for eSync 2 high-Z ports (3.3 V max)." (exclude_from_sim no) (at 430 345 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6ddae421-8fca-402a-994a-8c985ff80ed3")) (text "HastaDAQ" (exclude_from_sim no) (at 20 20 0) (effects (font (size 3 3) (bold yes)) (justify left bottom)) (uuid "77f4a871-2b56-48a8-9f15-f88cb083e06c")) (text "Net labels connect everything: same name = same net. +3V3 / GND are plain labels, not power symbols." (exclude_from_sim no) (at 20 27 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "58860e65-8931-44a2-a24d-6b3245eff7b1")) (text "Pimoroni Pico Plus 2 (+ RM2 on SP/CE): same 40-pin header as Pico 2 W. I2C0 = GP4/GP5 (header pins 6/7), hard-wired\nto the IMU Qwiic-breakout header and both ADS122C04 boards by header pins. Crossed-out pins are intentionally unused." (exclude_from_sim no) (at 20 36 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "54f8d07f-aaf3-47ea-b1ab-974b53dcf507")) (text "NOTES\n1. ONE common GND (Pico, sensors, servo PSU). SBUS needs a shared ground reference.\n   RM2 WiFi breakout (off-board, cabled to the Pico Plus 2 SP/CE connector): uses GP32-GP36 only, no overlap with I2C (GP4/5) or any other signal.\n2. ADS2: bridge one address jumper on its back (A0/A1); resulting address unconfirmed --\n   firmware falls back to an I2C scan at boot. I2C pull-ups: rely on the Adafruit breakouts' on-board pull-ups.\n3. Each half-bridge module (2 gauges) plugs into a 3-pin header: V, SIG (mid-point), GND. SIG -> A0 of its ADC, direct\n   (no input filter). ONE shared pair of fixed 350R completion resistors; its mid-point (ADS_REF) goes to A1 of BOTH\n   ADCs. Excitation is the ADC's own VIN, so VREF_SUPPLY is ratiometric -- no Ref+/Ref- wiring.\n4. SBUS: GP20 (TX) and GP21 (RX) on one net (UART inverted in firmware). One 3x6 servo header (6 plugs of V, SIG, GND;\n   footprint HastaDAQ:PinHeader_3x06): V = VSERVO (8.4 V), SIG = SBUS (all six in parallel), GND.\n5. POWER: 12 V in -> fuse -> +12V rail -> (a) Pololu D42V55F8 = VSERVO 8.4 V (servos), (b) SparkFun BabyBuck 5V = +5V (Orbis,\n   Schottky -> Pico VSYS). VSYS max is 5.5 V. USB (VBUS) is left for programming; with USB only, +5V is not live.\n6. Trigger pins are 3.3 V logic only. Pin order on the headers: see each symbol.\n   Main supply cable (2x4, pins 1-8 row-major): 1,8 VSUPPLY (12 V) | 2,7 VGND | 3 TRIG_IN | 6 TRIG_OUT | 4 SOFTSTOP+ | 5 SOFTSTOP-.\n   SOFTSTOP+ -> 1k -> GP16 (10k pull-up to 3V3), SOFTSTOP- = GND: loop closed = run, loop broken = stop (fail-safe on a cable break).\n   Use a keyed/shrouded header; a 0.1in header pin is only good for ~1-3 A, so check the servo peak current against 2 supply pins.\n7. Encoders: 4 x 2x4 headers (pins 1-8: GND, CS, SCK, MOSI, MISO, 3V3, 5V, GND) on one SPI1 bus; CS = GP13/GP9/GP8/GP7.\n   MT6835 uses 3V3 (3.3 V logic); RLS Orbis uses 5V with 3.3 V logic. Check MISO tri-states when CS is high.\n   The four ENC headers are a generic SPI port (SPI1: SCK GP10, MOSI GP11, MISO GP12, own CS each, 3V3 and 5V supply), so any 3.3 V\n   SPI device can be plugged in, not just encoders. Each device needs its own CS and an MISO that tri-states when CS is high.\n8. Use shielded twisted cable for the gauge wires, shield to GND at the ADC end only." (exclude_from_sim no) (at 20 405 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d1e920f6-58c2-4b2b-a5f4-dbc63a5102c3")) (sheet_instances (path "/" (page "1"))) (embedded_fonts no))